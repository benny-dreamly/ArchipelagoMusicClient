<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- Line length: keep lines under 120 chars (ignore package/import lines) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package |import ).*"/>
    </module>

    <module name="TreeWalker">
        <!-- Required for @SuppressWarnings to work -->
        <module name="SuppressWarningsHolder"/>

        <!-- Allow underscores in lambda parameters like _, __, ___ -->
        <module name="LambdaParameterName">
            <property name="format" value="^(_+|[a-z][a-zA-Z0-9]*)$"/>
        </module>

        <!-- Basic naming (already matches your style) -->
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <!-- Allow UnderscoreNames in test method names: method_case describes the scenario -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="TypeName"/>

        <!-- Code quality checks (lenient) -->
        <module name="EmptyBlock">
            <property name="option" value="text"/> <!-- allows blocks with comments -->
        </module>
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/> <!-- allows if (x) return; -->
        </module>

        <!-- Import checks -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Logging: use a slf4j Logger, never raw stdout/stderr -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="Use a slf4j Logger instead of System.out/System.err"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- Useful bug catchers -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
    </module>
</module>